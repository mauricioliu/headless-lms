    "@headless-lms/core": "workspace:*",
    "better-auth": "^1.6.25",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsdown": "^0.22.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
